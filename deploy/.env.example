# VMS AI Camera — docker-compose secrets template
#
# Copy this file to `.env` (in the same directory as docker-compose.yml)
# and fill in the values. `.env` is gitignored.
#
# Every `?required` variable is enforced by compose — `docker compose up`
# refuses to start if any is unset, with a clear error message.

# ─── Backend ────────────────────────────────────────────────────────────
# JWT signing secret. MUST be at least 32 characters. The backend refuses
# to start with the well-known default sentinel — see config.cpp SEC-C1.
# Generate: openssl rand -base64 36  (or PowerShell:
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(36)) )
VMS_JWT_SECRET=replace-me-with-32-plus-random-chars-from-csprng-please

# Storage required at boot? `1` = fail-fast if MinIO unreachable (prod
# default). `0` = boot in degraded mode (dev). See H7 commit 275b7cd.
VMS_STORAGE_REQUIRED=1

# ─── PostgreSQL ─────────────────────────────────────────────────────────
# Database name + user. Defaults are fine for most deployments.
POSTGRES_DB=vms
POSTGRES_USER=vms

# Password for the `vms` PostgreSQL user. Required — no default.
# Generate: openssl rand -base64 24
VMS_PG_PASSWORD=replace-me-postgres-password

# ─── MinIO (S3-compatible storage) ──────────────────────────────────────
# Root credentials. Backend uses these via VMS_MINIO_ACCESS_KEY /
# VMS_MINIO_SECRET_KEY env vars (see backend.yaml comment block on the
# storage section).
# Generate both: openssl rand -base64 18  (twice)
VMS_MINIO_ACCESS_KEY=replace-me-minio-access-key
VMS_MINIO_SECRET_KEY=replace-me-minio-secret-key

# ─── Caddy (TLS termination) ────────────────────────────────────────────
# Public domain Caddy will serve. MUST resolve to this host's public IP
# before bringing the stack up — Let's Encrypt's HTTP-01 challenge
# verifies the domain points back here.
VMS_DOMAIN=vms.example.com

# Account email for Let's Encrypt ACME registration. They use this to
# warn about expiring certs (Caddy auto-renews, but if renewal ever
# breaks, this is how you'll find out).
ACME_EMAIL=ops@example.com
