# VITE_API_URL intentionally unset — when set to a cross-origin URL the browser
# requires a CORS preflight on every authenticated/mutation request, and Crow's
# auto-OPTIONS path short-circuits before request headers are parsed, so the
# preflight response cannot carry Access-Control-Allow-Origin. Leaving this
# unset routes /api/* through the Vite proxy (vite.config.js) → same-origin
# from the browser's perspective → no preflight. See vms_app.h CORSMiddleware
# block comment for the framework-level details.
# VITE_API_URL=http://localhost:8000
VMS_ENV=dev
VITE_WS_URL=ws://localhost:8083/ws
