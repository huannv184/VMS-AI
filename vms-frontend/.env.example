# Frontend runtime URL configuration. Copy to `.env` (gitignored) and adjust
# per deployment. Both vars are read by `src/utils/runtimeUrls.js` at build
# time — Vite bakes them into the bundle, so changes require a rebuild.

# ── API base URL ───────────────────────────────────────────────────────────
# Leave UNSET for:
#   - Dev with `vite dev` + Vite proxy forwarding /api/* to the backend
#   - Prod with FE + backend on the SAME origin (most common)
# Set when:
#   - FE is served from a different host than the backend (CDN, static
#     bucket, separate API gateway). Use the publicly-reachable backend URL.
# Example:
# VITE_API_URL=https://api.example.com

# ── WebSocket base URL ─────────────────────────────────────────────────────
# Fallback chain in runtimeUrls.js: VITE_WS_URL → derived from VITE_API_URL
# (same host, /ws path, ws/wss matching protocol) → dev `hostname:8083/ws`.
# Leave UNSET for:
#   - Dev (uses hostname:8083/ws to skip the Vite proxy that truncates
#     binary FMP4 frames)
#   - Prod where WS lives on the same host as the API (auto-derived)
# Set when:
#   - WS is on a different host than the API
#   - You need a non-/ws path
# Example:
# VITE_WS_URL=wss://ws.example.com/ws
